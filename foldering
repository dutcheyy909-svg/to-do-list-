{
  "repository": "dutcheyy909-svg/music-catalog",
  "action": "add_json_schemas",
  "status": "completed",
  "structure": {
    "projects": {
      "schema": "project.schema.json",
      "gitkeep_required": false
    },
    "releases": {
      "schema": "release.schema.json",
      "gitkeep_required": false
    },
    "stems_metadata": {
      "schema": "stems.schema.json",
      "gitkeep_required": false
    },
    "sync_cues": {
      "schema": "sync_cue.schema.json",
      "gitkeep_required": false
    },
    "vocal_chains": {
      "schema": "vocal_chain.schema.json",
      "gitkeep_required": false
    },
    "lyrics": {
      "schema": null,
      "gitkeep_required": true
    },
    "workflows": {
      "schema": null,
      "gitkeep_required": true
    }
  },
  "schemas": {
    "project": {
      "path": "projects/project.schema.json",
      "purpose": "Defines the main source-of-truth structure for music projects."
    },
    "release": {
      "path": "releases/release.schema.json",
      "purpose": "Defines release metadata for singles, EPs, albums and other releases."
    },
    "stems": {
      "path": "stems_metadata/stems.schema.json",
      "purpose": "Defines metadata for audio stems and their technical properties."
    },
    "sync_cue": {
      "path": "sync_cues/sync_cue.schema.json",
      "purpose": "Defines sync licensing, availability, rights and placement metadata."
    },
    "vocal_chain": {
      "path": "vocal_chains/vocal_chain.schema.json",
      "purpose": "Defines recording, processing, plugin and vocal-chain information."
    }
  },
  "relationships": {
    "primary_key": "project_id",
    "source_of_truth": "projects/project.schema.json",
    "linked_data": [
      "release_id",
      "project_id",
      "lyrics_file",
      "stems_metadata_file",
      "vocal_chain_file",
      "sync_cue_file"
    ]
  },
  "gitkeep_policy": {
    "description": ".gitkeep is only required for directories that would otherwise be empty.",
    "remove_from": [
      "projects",
      "releases",
      "stems_metadata",
      "sync_cues",
      "vocal_chains"
    ],
    "keep_in": [
      "lyrics",
      "workflows"
    ]
  },
  "current_structure": [
    "projects/project.schema.json",
    "releases/release.schema.json",
    "stems_metadata/stems.schema.json",
    "sync_cues/sync_cue.schema.json",
    "vocal_chains/vocal_chain.schema.json",
    "lyrics/.gitkeep",
    "workflows/.gitkeep"
  ],
  "next_step": "Create example JSON catalog records that validate against each schema."
}
